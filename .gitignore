# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example 포함해 전부 제외한다(사용자 지정, 2026-07-28).
# 키 이름만 담은 템플릿이라도 저장소에 두지 않는다. 필요한 키 목록은
# plan/가이드_외부API키발급(external-api-keys) 문서가 관리한다.
.env*

# 업로드된 상품 이미지 — 운영 데이터라 저장소에 넣지 않는다.
# 경로는 PARASOL_UPLOAD_DIR로 바꿀 수 있다(운영에서는 별도 볼륨 권장).
/uploads/

# IDE
.idea/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
