# 이 파일은 키 이름 템플릿이다. 실제 값은 .env에 직접 기입할 것 (.env는 커밋 금지, Claude 접근 금지 — CLAUDE.md RULE-1)

# 로컬 개발: SSH 터널(로컬 15432 → 명율 서버 5432) 경유 PostgreSQL
# 터널: ssh -N -o ServerAliveInterval=60 -L 15432:127.0.0.1:5432 parasol@<명율서버IP>
DATABASE_URL=postgresql://parasol_app:<비밀번호>@127.0.0.1:15432/parasol

# 고객 세션 JWT(HS256) 서명 비밀키 — 32자 이상 필수. 교체하면 전체 세션이 즉시 무효화된다.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=<32자_이상_랜덤_문자열>

# 시드(npm run db:seed)로 만들 초기 관리자 계정.
# 비밀번호는 bcrypt로 해시해 저장되며 평문은 DB에 남지 않는다.
# SEED_ADMIN_PASSWORD가 없으면 관리자 계정 생성만 건너뛴다(나머지 시드는 실행).
SEED_ADMIN_LOGIN_ID=admin
SEED_ADMIN_PASSWORD=<초기_관리자_비밀번호>
SEED_ADMIN_NAME=최고관리자

# ─────────────────────────────────────────────────────────────
# 토스페이먼츠 — developers.tosspayments.com → 내 개발정보 → API 키
# 이 파일은 커밋되므로 **실제 키 값을 여기 넣지 않는다.** 값은 .env에만 둔다.
# 미설정이면 스텁 게이트웨이로 동작한다(개발·통합검증용 가짜 승인기).
# ─────────────────────────────────────────────────────────────

# 클라이언트 키 — 브라우저로 나가는 공개 키. test_ck_… / live_ck_…
NEXT_PUBLIC_TOSS_CLIENT_KEY=<토스_클라이언트_키>

# 시크릿 키 — 서버 전용. test_sk_… / live_sk_…
# 승인·취소 권한을 그대로 가지므로 NEXT_PUBLIC_ 접두어를 절대 붙이지 않는다(RULE-11).
TOSS_SECRET_KEY=<토스_시크릿_키>

# API 버전 — 개발자센터에서 선택한 값(예: 2024-06-01). 미설정이면 상점 기본값이 쓰인다.
# 응답 스키마가 버전마다 다르므로 코드가 기대하는 버전을 명시해 고정한다.
TOSS_API_VERSION=<YYYY-MM-DD>

# (선택) 웹훅 1차 필터 — 토스 규약이 아니다.
# 일반 결제 웹훅에는 서명 헤더가 없으므로(공식 문서 §7.2) 진짜 검증은 조회 API 재확인이 한다.
# 프록시·게이트웨이에서 헤더를 주입하는 운영 구성일 때만 설정한다.
TOSS_WEBHOOK_SECRET=<토스_웹훅_시크릿>

# 참고 — 지금 쓰지 않는 키
#  · 보안 키: 정산지급대행·현금영수증 등 별도 서비스용. 결제 승인·취소에는 불필요
#  · 머트 키: 구 모듈(XPay) 연동 상점 전용. 신규 연동에는 불필요
